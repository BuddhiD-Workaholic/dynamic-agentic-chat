# Any OpenAI-compatible endpoint. The app talks Chat Completions, so it runs
# unchanged against OpenAI, MiniMax, Together, Groq, OpenRouter, vLLM, etc.
# Only these three values change.

# OpenAI:  https://api.openai.com/v1
# MiniMax: https://api.minimax.io/v1
OPENAI_BASE_URL=https://api.minimax.io/v1

OPENAI_API_KEY=sk-...

# Model id as your provider names it.
#   OpenAI  -> gpt-4o
#   MiniMax -> MiniMax-M2
MODEL=MiniMax-M2

# Optional: a smaller/faster model for the routing (intent) call. Falls back to
# MODEL when unset. Routing output is tiny, so a cheap model is usually enough.
# ROUTER_MODEL=MiniMax-M2
